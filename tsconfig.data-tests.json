    "rootDir": "src",
    "resolveJsonModule": true
  },
  "include": [
    "src/application/practice-lifecycle.ts",
    "src/domain/**/*.ts",
    "src/data/**/*.ts",
    "src/audio/controller.ts",
    "src/audio/policy.ts",
    "src/audio/session-controller.ts",
    "src/ui/ocean-geometry.ts",
