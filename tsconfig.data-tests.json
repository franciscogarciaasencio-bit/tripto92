    "src/ui/forest-geometry.ts",
    "src/ui/category-presentation.ts",
    "src/cloud/config.ts",
    "src/cloud/secure-storage.ts",
    "src/cloud/auth-callback.ts",
    "src/cloud/ledger-client.ts",
    "src/application/sync-engine.ts",
    "src/application/sync-status.ts",
    "src/ui/intentions.ts",
    "src/ui/streak-geometry.ts",
