{
  "expo": {
    "name": "Ona",
    "slug": "MeditationApp",
    "owner": "tripto92",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "meditationapp",
    "extra": {
      "eas": { "projectId": "3ec57447-1b2b-428b-a9cf-dd0216e351b5" }
    },
    "userInterfaceStyle": "light",
    "backgroundColor": "#F2E9DA",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.meditation.ona",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F2E9DA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      ["expo-router", { "headers": { "Cross-Origin-Embedder-Policy": "credentialless", "Cross-Origin-Opener-Policy": "same-origin" } }],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2E9DA",
          "android": { "image": "./assets/images/native-splash-transparent.png", "imageWidth": 1 }
        }
      ],
      "expo-sqlite",
      "expo-asset",
      ["expo-audio", {
        "microphonePermission": false,
        "recordAudioAndroid": false,
        "enableBackgroundRecording": false,
        "enableBackgroundPlayback": true
      }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
